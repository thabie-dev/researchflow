# --- Server ---
PORT=4000
CORS_ORIGIN=*

# --- Storage ---
# Flat-file JSON store lives here. Swap services/store.js for a real DB later
# (Postgres/Mongo) without touching the routes if you outgrow this.
DATA_DIR=./data

# --- AI tool discovery (optional but recommended) ---
# Turns on the background job that keeps the "AI tools for this stage" lists fresh.
DISCOVERY_ENABLED=true
# Cron expression, default = every Monday 03:00
CRON_SCHEDULE=0 3 * * 1

# Pick ONE web search provider so discovery can find new tools.
# Leave both blank and discovery will only re-verify/curate the seed list.
SEARCH_PROVIDER=serpapi   # serpapi | bing | none
SERPAPI_KEY=
BING_API_KEY=

# Used to turn raw search results into structured, deduped tool entries,
# and to power the optional AI-generated (rather than templated) research
# assistant output. If left blank, both fall back to static logic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
